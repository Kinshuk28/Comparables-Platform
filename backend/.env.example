DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fairness_opinion

# Free by default: this points at Groq's free-tier OpenAI-compatible API, so you can
# generate fairness opinion reports at no cost. Get a free key (no credit card) at
# https://console.groq.com/keys and paste it below.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.1-8b-instant

# To use real OpenAI instead (paid), set:
#   OPENAI_BASE_URL=
#   OPENAI_MODEL=gpt-4o-mini
# To use Google Gemini's free tier instead (no credit card, get a key at
# https://aistudio.google.com/apikey), set:
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.0-flash

CORS_ORIGINS=http://localhost:3000
